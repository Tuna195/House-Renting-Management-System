# Copy file này thành ".env" rồi điền giá trị thật. KHÔNG commit file .env lên Git.

# Chuỗi kết nối PostgreSQL. Mỗi thành viên nên tạo 1 database riêng trên https://neon.tech (miễn phí)
# để khi chạy migration không ảnh hưởng nhau. Xem README.md mục "Cài đặt".
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Khóa bí mật để ký JWT. Gõ một chuỗi ngẫu nhiên dài (>= 16 ký tự).
JWT_SECRET="doi-thanh-chuoi-ngau-nhien-that-dai"
JWT_EXPIRES_IN="7d"

PORT=4000

# Địa chỉ frontend được phép gọi API (nhiều địa chỉ cách nhau bằng dấu phẩy)
CORS_ORIGIN="http://localhost:5173"
